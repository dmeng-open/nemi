OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nemi

EVENT_PROVIDER=mock
PLACE_PROVIDER=mock
CALENDAR_PROVIDER=local

APP_TIMEZONE=America/Chicago
APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. Leave empty to keep mock events, mock restaurants, and the local calendar.
TICKETMASTER_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/calendar/callback

# Optional per-agent model overrides. Empty uses OPENAI_MODEL.
SUPERVISOR_MODEL=
RESEARCH_MODEL=
PLANNER_MODEL=
CRITIC_MODEL=

LANGGRAPH_CHECKPOINTING=true
ENVIRONMENT=local

MAX_REPLAN_ATTEMPTS=3
MAX_SUPERVISOR_STEPS=20
MAX_TOOL_CALLS_PER_AGENT=10
MAX_TOTAL_LLM_CALLS=12
SPECIALIST_TIMEOUT_SECONDS=25

# Test-only. Leave empty. Ignored when ENVIRONMENT=production.
FAILURE_INJECTION=
